# ==============================================================================
# VideoAssist FastAPI Backend Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Application Metadata
PROJECT_NAME="VideoAssist Backend"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server Network Configuration
HOST="0.0.0.0"
PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Security & Internal Service Authentication
# Shared secret for internal dispatch between Next.js server actions and FastAPI
FASTAPI_INTERNAL_TOKEN="placeholder-internal-secret-token"

# Supabase Credentials (Required for storage download and database updates)
SUPABASE_URL="https://placeholder-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="placeholder-service-role-key"

# Storage Bucket Names (Must match Supabase Storage buckets)
STORAGE_BUCKET_VIDEOS="field-service-videos"
STORAGE_BUCKET_ARTIFACTS="video-artifacts"

# Temporary Directory for Video Preprocessing & Artifact Storage
TEMP_STORAGE_DIR="/tmp/videoassist"

# Speech Transcription Configuration (faster-whisper)
# Model size: 'tiny', 'base', 'small', 'medium', 'large-v3'.
# 'base' is recommended for local development (fast, low memory ~74MB download on first run).
# For Apple Silicon / macOS, 'auto' or 'cpu' device with 'default' or 'int8' compute type is recommended.
WHISPER_MODEL_SIZE="base"
WHISPER_DEVICE="auto"
WHISPER_COMPUTE_TYPE="default"
# Optional ISO 639-1 language code (e.g. 'en') to force transcription language.
# Leave commented or empty to enable automatic spoken language detection.
# WHISPER_LANGUAGE="en"
# Optional custom directory for caching model weights. Defaults to ~/.cache/huggingface/hub.
# WHISPER_DOWNLOAD_ROOT=""
